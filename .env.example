# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── Database (Neon Postgres) ─────────────────────────────
# Use a Neon dev branch for local work — get the pooled connection string from
# the Neon dashboard (Connect → Pooled connection).
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/motive?sslmode=require

# ── Auth ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_32+_char_random_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── Refresh-token cookie ────────────────────────────────
# Same registrable domain (app.x.com + api.x.com): COOKIE_SAMESITE=lax, COOKIE_DOMAIN=.x.com
# Cross-site (vercel.app + onrender.com):           COOKIE_SAMESITE=none, COOKIE_SECURE=true (HTTPS)
COOKIE_NAME=motive_rt
COOKIE_SAMESITE=lax
# COOKIE_SECURE defaults to true in production; set explicitly if needed.
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.yourdomain.com

# ── CORS / frontend ─────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Google OAuth login ───────────────────────────────────
# Optional — email/password auth works fine without it, "Continue with
# Google" just won't appear. Create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials — the Authorized
# redirect URI there must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. http://localhost:8080/api/auth/google/callback in dev
GOOGLE_REDIRECT_URI=

# ── Error tracking (Sentry) ──────────────────────────────
# Optional — the app runs fine without it, errors just only go to stdout.
# Create a project at https://sentry.io and paste its DSN here.
SENTRY_DSN=

# ── Logging (src/config/logger.js) ───────────────────────
# LOG_LEVEL: optional, defaults to 'info' in production / 'debug' otherwise.
# One of pino's levels: fatal, error, warn, info, debug, trace.
LOG_LEVEL=

# LOGTAIL_SOURCE_TOKEN: optional. Without it, structured logs still go to
# stdout (Render's dashboard reads that directly) — this just also ships the
# same logs to Better Stack (betterstack.com/logs, free tier: 1GB/month
# ingestion, 3-day retention) for longer retention and real search. Create a
# source there (JavaScript/pino) and paste its token here.
LOGTAIL_SOURCE_TOKEN=

# ── File storage (Cloudflare R2) ────────────────────────
# Optional in development — uploads fall back to local disk (public/uploads/)
# when unset. REQUIRED in production on Render: its disk is ephemeral and
# wiped on every deploy/restart, so local-disk uploads silently vanish there.
# Create a bucket at https://dash.cloudflare.com → R2, an API token scoped to
# it (Account → R2 → Manage API Tokens), and enable public access (or a
# custom domain) for R2_PUBLIC_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# e.g. https://pub-xxxxxxxx.r2.dev or your own mapped custom domain
R2_PUBLIC_URL=

# ── Email (Resend — password reset) ─────────────────────
# Get a key from https://resend.com/api-keys (free tier is plenty at this
# scale). Without it, password-reset emails just no-op with a console
# warning rather than crashing the app — see src/services/email.service.js.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend, or use their shared sandbox
# sender below (fine for dev/testing, not for real user-facing email).
EMAIL_FROM=Motive <onboarding@resend.dev>

# ── Payments (Stripe) ────────────────────────────────────
# Use TEST mode keys (sk_test_..., whsec_...) for local/dev — never commit live keys.
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen --forward-to localhost:8080/api/payments/webhook` (Stripe CLI)
# or the webhook's signing secret in the Stripe Dashboard once deployed.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# One-time "Pro" upgrade, priced per currency the buyer can pick at checkout
# (smallest currency unit: cents for USD, paise for INR).
# Which actual payment methods show up (cards, Google Pay, Apple Pay, UPI/PhonePe,
# Link, etc.) is controlled in the Stripe Dashboard → Settings → Payment methods —
# NOT by this app. UPI (and therefore PhonePe/GPay-India/Paytm) additionally
# requires the Stripe account itself to be registered in India; it will not
# appear for an account registered anywhere else, regardless of these values.
PRO_UPGRADE_PRICE_USD_CENTS=999
PRO_UPGRADE_PRICE_INR_PAISE=79900
