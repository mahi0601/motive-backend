generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  owner
  editor
  viewer
}

enum InviteStatus {
  pending
  accepted
  declined
  revoked
}

enum BlockType {
  paragraph
  heading1
  heading2
  heading3
  bulleted
  numbered
  todo
  toggle
  quote
  code
  divider
  image
  callout
  table
  embed
}

enum TaskPriority {
  Low
  Medium
  High
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  // Never selected by default — see `omit` config in src/config/prisma.js.
  // Nullable: a Google-only account (see auth.service.js#loginWithGoogle)
  // has no password to compare against.
  password         String?
  // Set the first time a user signs in with Google — also used to link an
  // existing password-based account by matching email on first Google login.
  googleId         String?  @unique
  avatar           String   @default("")
  // IANA zone name (e.g. "America/New_York"). Used to bucket the Momentum
  // endpoint's week/month/quarter ranges in the user's own day, instead of
  // the database server's timezone — see statistics.service.js.
  timezone         String   @default("UTC")
  // Bumped on logout / password change to invalidate all outstanding refresh tokens.
  tokenVersion     Int      @default(0)
  // One-time "Pro" upgrade, set by the Stripe webhook once payment is confirmed.
  // `isPro` is the ONE effective flag every gate reads (member cap, Momentum
  // periods, the UI). It is derived: `proLifetime || an active subscription`.
  // proLifetime marks the original one-time purchase (and was backfilled for
  // everyone who had isPro when subscriptions launched), so those users stay
  // Pro forever regardless of any subscription's lifecycle.
  isPro            Boolean  @default(false)
  proLifetime      Boolean  @default(false)
  stripeCustomerId String?
  // Monthly subscription state, kept in sync by Stripe webhooks (see
  // payment.service.js). stripeSubscriptionId is globally omitted from queries
  // (config/prisma.js) — the client never needs it.
  stripeSubscriptionId         String?   @unique
  subscriptionStatus           String?   // Stripe's status: active, trialing, past_due, unpaid, canceled, …
  proPeriodEnd                 DateTime? // end of the paid period — "renews on" / "ends on"
  subscriptionCancelAtPeriodEnd Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tasks           Task[]
  assignedTasks   Task[]   @relation("TaskAssignee")
  pages           Page[]
  workspacesOwned Workspace[]
  memberships     WorkspaceMember[]
  invitesSent     WorkspaceInvite[]
  comments        Comment[]
  filesUploaded   File[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  templates       Template[]
  sessions        Session[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String   @default("My Workspace")
  icon      String   @default("🏠")
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  pages     Page[]
  tasks     Task[]
  // Public client status page (GET /api/status/:token). Only the sha256 of
  // the share token is stored — same pattern as WorkspaceInvite.tokenHash —
  // so a database read can't reveal a working link. `shareEnabledAt` is what
  // the UI reads to know sharing is on (the hash itself is globally omitted
  // from queries, see config/prisma.js); both are null when sharing is off.
  shareTokenHash String?   @unique
  shareEnabledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Mongo's embedded `members[]` subdocument becomes a join table.
model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(editor)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// Lets an invite reach someone who doesn't have a Motive account yet —
// `inviteMember` used to require an existing account, which defeated the
// point of inviting someone. `tokenHash` is sha256(raw); the raw token only
// ever exists in the invite email, never stored — see workspace.service.js.
model WorkspaceInvite {
  id           String       @id @default(cuid())
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String
  role         WorkspaceRole @default(editor)
  tokenHash    String       @unique
  status       InviteStatus @default(pending)
  invitedById  String
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // A re-invite recycles this row (new token, reset expiry) instead of
  // inserting a second pending invite for the same email.
  @@unique([workspaceId, email])
  @@index([workspaceId, status])
}

model Page {
  id          String     @id @default(cuid())
  title       String     @default("Untitled")
  icon        String     @default("📄")
  cover       String     @default("")
  parentId    String?
  parent      Page?      @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Page[]     @relation("PageTree")
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  archived    Boolean    @default(false)
  favorite    Boolean    @default(false)
  position    Int        @default(0)
  blocks      Block[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([workspaceId])
  @@index([ownerId])
}

model Block {
  id        String    @id @default(cuid())
  pageId    String
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      BlockType @default(paragraph)
  // Freeform payload: { text, checked, language, url, caption, collapsed, color, ... }
  content   Json      @default("{}")
  position  Int       @default(0)
  // One level of nesting under a 'toggle' block — null for top-level blocks.
  // `position` is scoped within siblings sharing the same parentBlockId, so
  // reordering children never touches top-level positions and vice versa.
  parentBlockId String?
  parent        Block?  @relation("BlockChildren", fields: [parentBlockId], references: [id], onDelete: Cascade)
  children      Block[] @relation("BlockChildren")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([pageId])
  @@index([parentBlockId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  priority    TaskPriority @default(Low)
  status      TaskStatus   @default(todo)
  category    String       @default("Personal")
  dueDate     DateTime?
  // Set/cleared whenever `status` transitions to/from 'done' (task.service.js)
  // — the source of truth for "completed" stats, since `updatedAt` also
  // changes on unrelated edits.
  completedAt DateTime?
  tags        String[]     @default([])
  // Null = one-off task. When set, completing this task creates the next
  // occurrence (see task.service.js#update) rather than a scheduled job
  // generating instances ahead of time — simpler, and naturally idempotent
  // (one next-occurrence per completion, no risk of double-generating).
  recurrence  RecurrenceFrequency?
  position    Int?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable so a personal (solo) task is unaffected — backfilled to the
  // owner's default workspace for every existing task (see
  // scripts/backfill-task-workspace.js), so it's always set going forward.
  // Cascade on delete mirrors Page.workspaceId's existing behavior.
  workspaceId String?
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Who the task is for, distinct from `userId` (who created it) — the two
  // are the same person for every solo task today. SetNull, not Cascade: the
  // assignee leaving a workspace (or their account being deleted) should
  // unassign the task, not delete work owned by someone else.
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  subtasks    Subtask[]
  comments    Comment[]
  files       File[]
  activityLogs ActivityLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Hot path: "all of a user's tasks, ordered" / date-range lookups / board+stats filters.
  @@index([userId, position])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([userId, category])
  // Workspace-scoped equivalents of the above, for a shared client/team
  // workspace's board and Momentum's future per-workspace queries.
  @@index([workspaceId, status])
  @@index([assigneeId, status])
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model File {
  id         String   @id @default(cuid())
  name       String
  url        String
  // Bytes. Counted toward the uploader's storage quota; files uploaded before
  // quotas existed have 0 and so are not counted.
  size       Int      @default(0)
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([uploadedBy])
  @@index([taskId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  // Free-form category driving icon/color in the UI (e.g. 'comment', 'task', 'info').
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, read])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  description String?
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([taskId])
}

// Single-use, short-lived hand-off code for the native (Capacitor Android)
// Google Sign-In flow — see auth.service.js#createNativeExchangeCode. The
// system browser (where Google's consent screen runs) and the app's WebView
// are separate cookie jars, so the normal httpOnly-refresh-cookie bootstrap
// can't cross that boundary; this opaque code is handed back via a deep
// link instead, then exchanged for real tokens by a request the WebView
// itself makes (so the cookie lands in the right place). Deliberately not a
// JWT: a random, server-tracked, delete-on-use code can't be replayed even
// within its own expiry window once the legitimate exchange happens.
model NativeExchangeCode {
  code      String   @id
  userId    String
  // PKCE (RFC 7636, S256): base64url(sha256(code_verifier)) supplied by the
  // app when it started sign-in. The exchange must present the matching
  // verifier, so another app that registers the same custom URL scheme and
  // intercepts the deep link still can't redeem the code.
  codeChallenge String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// One row per login (browser, device, app). The refresh token carries this id
// plus `gen`, a counter bumped on every rotation:
//   - token gen == row gen        → valid; rotate (gen + 1)
//   - token gen == row gen - 1    → the previous token, replayed within a short
//                                   grace window (two tabs refreshing at once):
//                                   answer with the current generation, no bump
//   - anything older, or after the window → a stolen/replayed token: the whole
//                                   session is revoked
// Logout revokes one session; tokenVersion on User still means "log out
// everywhere". Access tokens carry `sid` and are checked against this row, so
// a revoked session stops working immediately instead of at token expiry.
model Session {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gen               Int       @default(0)
  prevGenValidUntil DateTime?
  expiresAt         DateTime
  revokedAt         DateTime?
  // sha256 prefix of the User-Agent — enough to tell sessions apart in a
  // future "your devices" list without storing the raw string.
  uaHash            String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Append-only record of security-relevant events (sign-ins, credential and
// membership changes, billing changes, deletions) for incident response.
// Deliberately has NO foreign keys: it must survive the deletion of the user or
// workspace it describes (an `account_deleted` row is the whole point), and it
// stores ids, never emails or names. `ip` is truncated to a /24 (IPv4) or /48
// (IPv6) before it is written. Pruned after 180 days by jobs/cleanup.js.
model SecurityEvent {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  type         String
  actorId      String?
  targetUserId String?
  workspaceId  String?
  ip           String?
  meta         Json?

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
}

// Idempotency ledger for Stripe webhooks — Stripe redelivers events on any
// non-2xx/timeout and can occasionally send the same event twice even on a
// clean 200. Recording `stripeEventId` first (unique) and no-op'ing on a
// conflict means a replay can never re-apply the handler's side effects,
// however many the handler grows to (today: one boolean; tomorrow: a
// receipt email, an ActivityLog entry, a credit grant...).
model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  createdAt     DateTime @default(now())
}

// A user-saved custom template: a named snapshot of a page's blocks.
// `blocks` stays a JSON column (it's a point-in-time copy, not a relation).
model Template {
  id          String   @id @default(cuid())
  name        String
  icon        String   @default("⭐")
  description String   @default("")
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blocks      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}
